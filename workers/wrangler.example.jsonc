{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "victor-quote-notifications",
  "main": "notifications.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "victor-quote-production",
      "database_id": "REPLACE_WITH_PRODUCTION_ID",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "REPLACE_WITH_VERIFIED_ARTIST_INBOX",
    },
  ],
  "vars": {
    "EMAIL_ENABLED": "false",
    "FROM_EMAIL": "notifications@YOUR_DOMAIN",
    "NOTIFICATION_TO": "REPLACE_WITH_VERIFIED_ARTIST_INBOX",
    "ADMIN_URL": "https://YOUR_DOMAIN/admin",
  },
}
